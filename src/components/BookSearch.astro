---
interface Props { books: any[] }
const { books } = Astro.props as Props;
// Extraer categorías únicas para el select
const categories = Array.from(new Set(books.map(b => b.data?.category).filter(Boolean)));
---

<div class="w-full">
  <div class="flex flex-col md:flex-row gap-3 items-center mb-6">
    <input id="authorFilter" placeholder="Buscar por autor..." class="w-full md:w-1/2 px-4 py-2 rounded border bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-400 transition" />
    <select id="categoryFilter" class="w-full md:w-1/3 px-4 py-2 rounded border bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-400 transition appearance-none">
      <option value="">Todas las categorías</option>
      {categories.map(cat => (
        <option value={cat}>{cat}</option>
      ))}
    </select>
  </div>

  <div id="booksList" class="grid gap-6 md:grid-cols-2">
    {books.map(book => {
      const { slug, data } = book;
      const { title, author, img, pagenumber, category } = data as any;
      return (
        <article class="flex bg-white/50 dark:bg-gray-900/60 rounded-lg p-3 items-center transition hover:shadow-lg" data-author={author?.toLowerCase() || ''} data-category={category || ''}>
          <a href={`/libro/${slug}`} class="mr-4 shrink-0 hover:scale-105 transition">
            <img 
            src={`/imgs/${img}`} 
            alt={title} 
            class="w-28 rounded"
            data-transition-name={`img-${slug}`}
            />
          </a>
          <div class="flex-1">
            <h3 data-transition-name={`name-${slug}`} class="text-lg font-semibold">{title}</h3>
            <p class="text-sm text-muted-foreground">Autor: <span class="font-medium">{author}</span></p>
            <p class="text-sm">Páginas: {pagenumber}</p>
            <p class="text-sm font-bold mt-1">{category}</p>
          </div>
        </article>
      )
    })}
  </div>

  <script type="module">
    /** @type {HTMLInputElement | null} */
    const input = document.getElementById('authorFilter');
    /** @type {HTMLSelectElement | null} */
    const select = document.getElementById('categoryFilter');
    /** @type {HTMLElement | null} */
    const list = document.getElementById('booksList');

    if (!input || !select || !list) {
      // elementos no encontrados — salir sin añadir listeners
      console.warn('BookSearch: elementos de filtro no encontrados');
    } else {
      function filter() {
        const q = (input.value || '').trim().toLowerCase();
        const cat = select.value;
        /** @type {HTMLElement[]} */
        const items = Array.from(list.querySelectorAll('article'));
        items.forEach(item => {
          const author = (item.getAttribute('data-author') || '').toLowerCase();
          const category = item.getAttribute('data-category') || '';
          const matchAuthor = q === '' || author.includes(q);
          const matchCat = cat === '' || category === cat;
          item.style.display = (matchAuthor && matchCat) ? '' : 'none';
        });
      }

      input.addEventListener('input', filter);
      select.addEventListener('change', filter);
    }
  </script>
</div>
