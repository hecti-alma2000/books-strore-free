---
import { ClientRouter } from "astro:transitions";
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

// Definimos los tipos para las "Props" (TypeScript)
interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
}

// Extraemos los valores de las props con valores por defecto
const {
	title,
	description = "Mi nuevo sitio web creado con Astro y Tailwind",
	image = '/favicon.svg',
	canonical = ''
} = Astro.props;

const site = import.meta.env.SITE ?? '';
const fullImage = site && image && !image.startsWith('http') ? new URL(image, site).toString() : image;
const canonicalUrl = canonical || site || '';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullImage} />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullImage} />

		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}

		<ClientRouter />
		<script is:inline>
			// Función para obtener el tema (localStorage > preferencia sistema)
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			};

			// Función para aplicar el tema al documento
			const applyTheme = () => {
				const theme = getTheme();
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
				// Opcional: Guardar en localStorage para asegurar consistencia
				localStorage.setItem('theme', theme);
			};

			// Ejecutar al cargar la página inicial
			applyTheme();

			// Ejecutar al navegar entre páginas (Importante para ClientRouter)
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>

	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased font-sans transition-colors duration-300">
    <div class="flex flex-col min-h-screen">
        
        <nav class="border-b border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-950/50 backdrop-blur-md sticky top-0 z-10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <a href="/" class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400">
                        Books Store
                    </a>
                    
                    <ThemeToggle />
                </div>
            </div>
        </nav>
        <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <slot /> 
        </main>
        
    </div>
</body>
</html>

<style is:global>
	/* Optimizamos el scroll */
	html {
		scroll-behavior: smooth;
	}
	
	body {
		/* Aseguramos que el layout use toda la pantalla horizontalmente */
		overflow-x: hidden;
	}

	/* NOTA: He eliminado el background y color hardcodeados aquí 
    porque ahora Tailwind se encarga de eso en el <body>.
    si los dejas, anularán el modo claro.
    */
</style>

<script is:inline>
(() => {
	const revealSelector = 'main > *, .reveal';

	function initReveal() {
		const items = Array.from(document.querySelectorAll(revealSelector));
		if (!items.length) return;

		const observer = new IntersectionObserver((entries, obs) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('in-view');
					obs.unobserve(entry.target);
				}
			});
		}, { root: null, rootMargin: '0px 0px -8% 0px', threshold: 0.06 });

		items.forEach(item => {
			if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if (!item.classList.contains('reveal')) item.classList.add('reveal');
			observer.observe(item);
		});
	}

	document.addEventListener('DOMContentLoaded', initReveal);
	document.addEventListener('astro:after-swap', () => setTimeout(initReveal, 80));
})();
</script>