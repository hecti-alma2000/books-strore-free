---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BookSearch from "../components/BookSearch.astro";
const books = await getCollection('books');
---

<Layout title="Home Page">
  <div class="container">
	<h1 class="text-center text-7xl font-extrabold mb-24">My <span class="block">Books</span></h1>
  <section aria-label="Listado de libros">
    <div class="px-4 mx-4 max-w-screen-xl">
      <BookSearch books={books} />
    </div>
  </section>
  </div>
</Layout>
